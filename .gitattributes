# Normalise line endings in the repository regardless of the checkout platform.
# The shell scripts under scripts/ and .husky/ break with CRLF.
* text=auto eol=lf

# Generated; keep it out of diffs and reviews.
package-lock.json linguist-generated=true -diff

# Binary, never merge.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff binary
*.woff2 binary
