# Copy to .env.local for local development. Never commit .env.local.
# Every page renders without these; they are needed to log in.
# Names are @auth0/nextjs-auth0 v4's (v3's AUTH0_BASE_URL and
# AUTH0_ISSUER_BASE_URL are no longer read).

# The Auth0 tenant, without https://
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# This app's own URL
APP_BASE_URL=http://localhost:3000

# Passed explicitly in src/lib/auth0.ts; v4 does not read them itself.
AUTH0_SCOPE=openid profile email offline_access
# The API's Auth0 identifier, so the access token is issued for gradfolio-api.
AUTH0_AUDIENCE=

# gradfolio-api's base URL, read on the server only (src/lib/api/client.ts).
# Never NEXT_PUBLIC_: the browser does not call the API (Q11). The API and
# `next dev` both default to port 3000, so locally one of them moves, e.g.
# API_HOST_PORT=3001 for the API's compose stack and API_BASE_URL=http://127.0.0.1:3001.
# Unset, /account says the API is not connected yet.
API_BASE_URL=
