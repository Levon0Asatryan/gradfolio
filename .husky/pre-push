# Cheapest check first: a push to main, or to a branch whose pull request is
# already merged, is wrong no matter how green the tests are.
sh scripts/check-branch.sh

# A code push carries a review receipt for this exact commit, so the reviewer sees
# finished work rather than the author's own defects.
sh scripts/require-review.sh

# Last gate before the change leaves the machine. Same checks CI runs, so a
# red pipeline is a surprise rather than a routine.
npm run verify
